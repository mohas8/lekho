{
  "name": "lekho",
  "version": "0.1.0",
  "private": true,
  "description": "Ridmik-style Bangla phonetic typing for Chrome: type Bangla directly on web pages, offline.",
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsx scripts/build.ts --mode production",
    "build:test": "tsx scripts/build.ts --mode test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build:test && npm run package && tsx scripts/build-fixtures.ts && playwright test",
    "fixtures": "npm run build:test && tsx scripts/fixtures-server.ts",
    "ridmik": "tsx scripts/ridmik-cli.ts",
    "suggest": "tsx scripts/suggest-cli.ts",
    "icons": "tsx scripts/gen-icons.ts",
    "package": "npm run build && tsx scripts/package.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lexical/history": "0.52.0",
    "@lexical/plain-text": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "lexical": "0.52.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-basic": "1.2.5",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "quill": "2.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
